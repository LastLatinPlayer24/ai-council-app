# AI Council - Provider API Keys
# Copy to .env and fill in your keys.
# Multiple keys can be set as comma-separated values for round-robin rotation.
# Keys sent from the frontend take priority; .env values serve as defaults.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Local models (Ollama / LMStudio)
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234

# Ollama Cloud — hosted large models, no GPU needed
# Create a key at https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1

# Server
HOST=0.0.0.0
PORT=8000